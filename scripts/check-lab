#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
lab_root="$(cd "$script_dir/.." && pwd)"
open_workbench="$script_dir/open-workbench"
lab_cli="$script_dir/lab"

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

for file in AGENTS.md CLAUDE.md README.md SECURITY.md .current-agent .gitignore; do
  [[ -f "$lab_root/$file" ]] || fail "missing $file"
done

for directory in scripts tests workspaces .worktrees; do
  [[ -d "$lab_root/$directory" ]] || fail "missing $directory/"
done

required_scripts=(
  check-current-agent
  check-lab
  check-native-parity
  check-secrets
  check-side-effects
  lab
  open-workbench
)
python_scripts=(
  check-native-parity
  check-secrets
  check-side-effects
  lab
  open-workbench
)

is_python_script() {
  local candidate="$1"
  local name
  for name in "${python_scripts[@]}"; do
    [[ "$candidate" == "$name" ]] && return 0
  done
  return 1
}

for name in "${required_scripts[@]}"; do
  [[ -x "$script_dir/$name" ]] || fail "missing executable scripts/$name"
  if is_python_script "$name"; then
    python3 -c \
      'import ast, pathlib, sys; ast.parse(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))' \
      "$script_dir/$name" ||
      fail "invalid Python syntax: scripts/$name"
  else
    bash -n "$script_dir/$name" || fail "invalid shell syntax: scripts/$name"
  fi
done

while IFS= read -r file; do
  name="$(basename "$file")"
  case "$name" in
    check-current-agent|check-lab|check-native-parity|check-secrets|check-side-effects|lab|open-workbench)
      ;;
    *)
      fail "unexpected Lab script: scripts/$name"
      ;;
  esac
done < <(find "$script_dir" -maxdepth 1 -type f | sort)

legacy_paths=(
  .agents
  .codex
  .codex-home
  .toolchain
  clink
  docs
  lab_agents
  registry
  waterflow
  README.zh-CN.md
)
for relative in "${legacy_paths[@]}"; do
  [[ ! -e "$lab_root/$relative" ]] || fail "obsolete Lab layer remains: $relative"
done

[[ ! -e "$lab_root/.cmux/cmux.json" ]] ||
  fail "project-level .cmux/cmux.json is forbidden"

python3 - "$open_workbench" "$lab_cli" <<'PY' ||
import ast
import pathlib
import re
import sys

open_path = pathlib.Path(sys.argv[1])
lab_path = pathlib.Path(sys.argv[2])
open_source = open_path.read_text(encoding="utf-8")
lab_source = lab_path.read_text(encoding="utf-8")
open_tree = ast.parse(open_source)
lab_tree = ast.parse(lab_source)

expected_layout = {
    "direction": "horizontal",
    "split": 0.5,
    "children": [
        {
            "pane": {
                "surfaces": [
                    {
                        "type": "terminal",
                        "name": "Codex CLI",
                    }
                ]
            }
        },
        {
            "direction": "vertical",
            "split": 0.5,
            "children": [
                {
                    "pane": {
                        "surfaces": [
                            {
                                "type": "terminal",
                                "name": "Claude Code",
                            }
                        ]
                    }
                },
                {
                    "pane": {
                        "surfaces": [
                            {
                                "type": "terminal",
                                "name": "Shell",
                                "focus": True,
                            }
                        ]
                    }
                },
            ],
        },
    ],
}

layout = None
for node in open_tree.body:
    if not isinstance(node, (ast.Assign, ast.AnnAssign)):
        continue
    targets = node.targets if isinstance(node, ast.Assign) else [node.target]
    if any(isinstance(target, ast.Name) and target.id == "WORKBENCH_LAYOUT" for target in targets):
        layout = ast.literal_eval(node.value)
        break
if layout != expected_layout:
    raise SystemExit("WORKBENCH_LAYOUT does not match the native three-shell contract")

constants = {
    node.value
    for node in ast.walk(open_tree)
    if isinstance(node, ast.Constant) and isinstance(node.value, str)
}
required = {
    "workspace",
    "create",
    "list",
    "--name",
    "--cwd",
    "--layout",
    "--focus",
    "--window",
    "--print-path",
}
missing = sorted(required - constants)
if missing:
    raise SystemExit("open-workbench creation contract is incomplete: " + ", ".join(missing))

forbidden_literals = {
    "--command",
    "--description",
    "--env",
    "--env-file",
    "send",
    "new-split",
    "hooks",
}
present = sorted(forbidden_literals & constants)
if present:
    raise SystemExit("forbidden cmux automation is present: " + ", ".join(present))

combined_source = open_source + "\n" + lab_source
if re.search(r"CODEX_HOME|CLAUDE_CONFIG_DIR|[A-Z][A-Z0-9_]*API_KEY", combined_source):
    raise SystemExit("client home or API key injection is present")
if re.search(r"\bgit\s+(push|merge|rebase|commit|reset|clean|checkout|switch|worktree)\b", combined_source):
    raise SystemExit("Git write operation is present")

def literal_command_tokens(node):
    if not isinstance(node, (ast.List, ast.Tuple)):
        return []
    return [
        item.value
        for item in node.elts
        if isinstance(item, ast.Constant) and isinstance(item.value, str)
    ]

for tree in (open_tree, lab_tree):
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call) or not node.args:
            continue
        tokens = literal_command_tokens(node.args[0])
        if tokens and tokens[0] in {"codex", "claude"}:
            raise SystemExit("native client auto-start is present")
PY
  fail "native-first script structure is invalid"

dry_run="$("$open_workbench" --dry-run "$lab_root")" ||
  fail "open-workbench dry-run failed"
python3 - "$dry_run" <<'PY' ||
import json
import shlex
import sys

line = sys.argv[1]
prefix = "DRY-RUN: "
if not line.startswith(prefix):
    raise SystemExit("missing dry-run prefix")
tokens = shlex.split(line[len(prefix):])
if len(tokens) < 4 or tokens[1:4] != ["--json", "workspace", "create"]:
    raise SystemExit("dry-run does not use canonical workspace create")
for required in ("--name", "--cwd", "--layout", "--focus"):
    if required not in tokens:
        raise SystemExit(f"dry-run is missing {required}")
for forbidden in (
    "--command",
    "--description",
    "--env",
    "--env-file",
    "send",
    "new-split",
    "hooks",
):
    if forbidden in tokens:
        raise SystemExit(f"dry-run contains forbidden token {forbidden}")
layout = json.loads(tokens[tokens.index("--layout") + 1])
surfaces = []
def walk(node):
    pane = node.get("pane")
    if isinstance(pane, dict):
        surfaces.extend(pane.get("surfaces") or [])
    for child in node.get("children") or []:
        walk(child)
walk(layout)
if [item.get("name") for item in surfaces] != ["Codex CLI", "Claude Code", "Shell"]:
    raise SystemExit("dry-run layout titles are invalid")
if any(item.get("type") != "terminal" for item in surfaces):
    raise SystemExit("dry-run layout contains a non-terminal surface")
if [item.get("name") for item in surfaces if item.get("focus") is True] != ["Shell"]:
    raise SystemExit("dry-run layout focus is invalid")
PY
  fail "open-workbench dry-run contract is invalid"

for command_name in cmux codex claude; do
  command_path="$(command -v "$command_name" || true)"
  [[ -n "$command_path" ]] || fail "$command_name is not on PATH"
  printf '%s: %s\n' "$command_name" "$command_path"
done

"$script_dir/check-native-parity" --json >/dev/null ||
  fail "native client parity failed"
"$lab_cli" status --json "$lab_root" >/dev/null ||
  fail "Lab status command failed"
"$script_dir/check-secrets" >/dev/null
"$script_dir/check-side-effects" >/dev/null

printf 'OK: native-first Agent Lab is valid\n'
