#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAB_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
RUNS_DIR="$LAB_ROOT/registry/runs"

# Run-record liveness gate (lab_agents/run_liveness.py). Detects runs that
# started but never finished (hung/abandoned) and ill-formed records. This is
# the run-record-side complement to the task-state stale-running detector.
#
# Exit semantics (fail-closed on real problems, advisory on young runs):
#   stale or ill_formed run present -> FAIL (exit 1)
#   only young unfinished runs       -> WARN (exit 0, advisory)
#   all finished                     -> PASS (exit 0)
#
# Optional: STALE_AFTER_SECONDS env overrides the deadline (default 3600).

if [ ! -d "$RUNS_DIR" ]; then
  printf 'FAIL: registry/runs directory missing\n' >&2
  exit 1
fi

cd "$LAB_ROOT"
STALE_AFTER_SECONDS="${STALE_AFTER_SECONDS:-3600}" python3 - "$RUNS_DIR" <<'PY'
import json
import os
import sys
from pathlib import Path

from lab_agents.run_liveness import run_liveness_report

runs_dir = Path(sys.argv[1])
deadline = int(os.environ.get("STALE_AFTER_SECONDS", "3600"))
report = run_liveness_report(runs_dir, stale_after_seconds=deadline)
s = report["summary"]

for issue in report["issues"]:
    print(f"  [{report['status']}] {issue['code']} {issue['run_id']}: {issue['reason']}")

print(
    f"runs: {s['run_count']}  finished: {s['finished_count']}  "
    f"unfinished: {s['unfinished_count']}  stale: {s['stale_count']}  "
    f"ill_formed: {s['ill_formed_count']}  (deadline {s['stale_after_seconds']}s)"
)
print(f"status: {report['status']}")

if report["status"] == "fail":
    sys.exit(1)
PY
