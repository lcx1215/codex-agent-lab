#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


LAB_ROOT = Path(__file__).resolve().parents[1]
if str(LAB_ROOT) not in sys.path:
    sys.path.insert(0, str(LAB_ROOT))

from lab_agents.scratch_durability import load_config, scratch_durability_report, write_snapshot


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Validate durable capture for configured scratch/assembly workspaces."
    )
    parser.add_argument("--root", type=Path, default=LAB_ROOT, help="Lab root to validate.")
    parser.add_argument("--config", type=Path, default=None, help="Scratch durability config path.")
    parser.add_argument("--current", type=Path, default=None, help="Current snapshot pointer path.")
    parser.add_argument("--json", action="store_true", help="Print structured JSON.")
    parser.add_argument(
        "--write-snapshot",
        metavar="SNAPSHOT_ID",
        help="Explicitly write a new durability snapshot, then update the current pointer.",
    )
    parser.add_argument("--workspace", help="Limit --write-snapshot to one workspace id.")
    return parser.parse_args()


def print_report(report: dict) -> None:
    summary = report["summary"]
    print(f"Scratch durability: {report['status']}")
    print(
        "Workspaces: {workspace_count}, files: {file_count}, fail: {fail_count}, warn: {warn_count}".format(
            **summary
        )
    )
    for workspace in report.get("workspaces", []):
        print(
            f"- {workspace['id']}: {workspace['status']} "
            f"files={workspace['files']} snapshot={workspace.get('current_snapshot')}"
        )
    for issue in report.get("issues", []):
        if issue["severity"] == "fail":
            stream = sys.stderr
        else:
            stream = sys.stdout
        evidence = "; ".join(issue.get("evidence", []))
        print(f"{issue['severity'].upper()} {issue['code']}: {issue['message']} {evidence}", file=stream)


def main() -> int:
    args = parse_args()
    root = args.root.expanduser().resolve()
    config_path = args.config.expanduser().resolve() if args.config else None
    current_path = args.current.expanduser().resolve() if args.current else None

    if args.write_snapshot:
        config = load_config(root, config_path)
        report = write_snapshot(root, config, args.write_snapshot, workspace_filter=args.workspace)
        if args.json:
            print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
        else:
            print(f"Scratch durability snapshot write: {report['status']}")
            for item in report.get("written", []):
                print(
                    f"- {item['workspace_id']}: snapshot={item['snapshot_id']} "
                    f"files={item['files']} copied={item['content_copied']} manifest={item['manifest']}"
                )
            for issue in report.get("issues", []):
                print(f"{issue['severity'].upper()} {issue['code']}: {issue['message']} {'; '.join(issue.get('evidence', []))}")
        return 1 if report["status"] == "fail" else 0

    report = scratch_durability_report(root, config_path=config_path, current_path=current_path)
    if args.json:
        print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print_report(report)
    return 1 if report["status"] == "fail" else 0


if __name__ == "__main__":
    raise SystemExit(main())
