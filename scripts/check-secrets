#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAB_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$LAB_ROOT"

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

test -d .git || fail "check-secrets must run from a git checkout"

python3 - "$LAB_ROOT" <<'PY' || exit 1
from __future__ import annotations

import os
from pathlib import Path
import re
import subprocess
import sys


root = Path(sys.argv[1])
historical_product_prefix = (
    "workspaces/agent-dev-workspace/external/merchant-portal-refactor-main-agent/"
)
source_pathspecs = [
    ".agents/skills",
    ".codex/agents",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "docs",
    "lab_agents",
    "registry/collaboration",
    "registry/runs",
    "registry/scratch-durability/config.json",
    "registry/scratch-durability/current.json",
    "registry/tasks",
    "scripts",
    "tests",
    f"{historical_product_prefix}.changeset",
    f"{historical_product_prefix}.vscode",
    f"{historical_product_prefix}.dockerignore",
    f"{historical_product_prefix}.env.example",
    f"{historical_product_prefix}.gitignore",
    f"{historical_product_prefix}AGENTS.md",
    f"{historical_product_prefix}MANIFEST.json",
    f"{historical_product_prefix}README.md",
    f"{historical_product_prefix}agents",
    f"{historical_product_prefix}apps",
    f"{historical_product_prefix}catalogs.json",
    f"{historical_product_prefix}docs",
    f"{historical_product_prefix}eslint.config.mjs",
    f"{historical_product_prefix}html-template",
    f"{historical_product_prefix}internal",
    f"{historical_product_prefix}package.json",
    f"{historical_product_prefix}packages",
    f"{historical_product_prefix}playground/src",
    f"{historical_product_prefix}pnpm-lock.yaml",
    f"{historical_product_prefix}pnpm-workspace.yaml",
    f"{historical_product_prefix}scripts",
    f"{historical_product_prefix}tsconfig.json",
    f"{historical_product_prefix}turbo.json",
    f"{historical_product_prefix}vite.config.mts",
    f"{historical_product_prefix}vitest.config.ts",
]

try:
    result = subprocess.run(
        [
            "git",
            "ls-files",
            "--cached",
            "--others",
            "--exclude-standard",
            "--",
            *source_pathspecs,
        ],
        cwd=root,
        text=True,
        capture_output=True,
        check=True,
    )
except subprocess.CalledProcessError as exc:
    if exc.stderr:
        sys.stderr.write(exc.stderr)
    print("FAIL: git ls-files failed", file=sys.stderr)
    sys.exit(1)

paths = [line for line in result.stdout.splitlines() if line]
forbidden_path = re.compile(r"(^|/)(auth\.json|\.env($|\.)|.*\.(pem|key|p12|pfx)$)")
secret_patterns = [
    re.compile(rb"gh[opsu]_[A-Za-z0-9_]{30,}"),
    re.compile(rb"github_pat_[A-Za-z0-9_]{20,}"),
    re.compile(rb"(^|[^A-Za-z0-9_])sk-[A-Za-z0-9_-]{20,}"),
    re.compile(rb"AKIA[0-9A-Z]{16}"),
    re.compile(rb"-----BEGIN (RSA |OPENSSH |EC |DSA )?PRIVATE KEY-----"),
]
source_prefixes = (
    ".agents/skills/",
    ".codex/agents/",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "docs/",
    "lab_agents/",
    "registry/collaboration/",
    "registry/runs/",
    "registry/scratch-durability/config.json",
    "registry/scratch-durability/current.json",
    "registry/tasks/",
    "scripts/",
    "tests/",
)
active_product_source_prefixes = (
    ".changeset/",
    ".vscode/",
    "agents/",
    "apps/",
    "docs/",
    "html-template/",
    "internal/",
    "packages/",
    "playground/src/",
    "scripts/",
)
active_product_root_files = {
    ".dockerignore",
    ".env.example",
    ".gitignore",
    "AGENTS.md",
    "MANIFEST.json",
    "README.md",
    "catalogs.json",
    "eslint.config.mjs",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "turbo.json",
    "vite.config.mts",
    "vitest.config.ts",
}
excluded_parts = {
    ".git",
    ".run",
    ".tmp",
    ".turbo",
    "coverage",
    "dist",
    "exports",
    "node_modules",
    "outputs",
}
source_suffixes = (
    ".bash",
    ".cjs",
    ".css",
    ".cts",
    ".html",
    ".js",
    ".json",
    ".lock",
    ".md",
    ".mjs",
    ".mts",
    ".py",
    ".scss",
    ".sh",
    ".sql",
    ".toml",
    ".ts",
    ".tsx",
    ".txt",
    ".vue",
    ".xml",
    ".yaml",
    ".yml",
)


def is_source_path(relative: str) -> bool:
    if relative.startswith(source_prefixes):
        return relative.endswith(source_suffixes) or "." not in Path(relative).name
    if not relative.startswith(active_product_prefix):
        return False
    inner = relative[len(active_product_prefix) :]
    if inner in active_product_root_files:
        return True
    if not inner.startswith(active_product_source_prefixes):
        return False
    return inner.endswith(source_suffixes) or "." not in Path(inner).name


secret_like_paths = [path for path in paths if forbidden_path.search(path)]
if secret_like_paths:
    for path in secret_like_paths:
        print(path, file=sys.stderr)
    print("FAIL: committable secret-like file path detected", file=sys.stderr)
    sys.exit(1)

findings: set[tuple[str, int]] = set()
scanned_files = 0
for relative in paths:
    parts = set(Path(relative).parts)
    if parts & excluded_parts:
        continue
    if not is_source_path(relative):
        continue
    file_path = root / relative
    if not file_path.is_file():
        continue
    try:
        data = file_path.read_bytes()
    except OSError as exc:
        print(f"{relative}: {exc}", file=sys.stderr)
        print("FAIL: unable to scan file for secrets", file=sys.stderr)
        sys.exit(1)
    if b"\0" in data[:4096]:
        continue
    scanned_files += 1
    for pattern in secret_patterns:
        match = pattern.search(data)
        if match:
            line = data.count(b"\n", 0, match.start()) + 1
            findings.add((relative, line))

if findings:
    for path, line in sorted(findings):
        print(f"{path}:{line}", file=sys.stderr)
    print("FAIL: secret-like token detected; content redacted", file=sys.stderr)
    sys.exit(1)

readme = root / "README.md"
try:
    readme_text = readme.read_text(encoding="utf-8")
except OSError as exc:
    print(f"README.md: {exc}", file=sys.stderr)
    print("FAIL: unable to scan README for machine-local paths", file=sys.stderr)
    sys.exit(1)
for line_no, line in enumerate(readme_text.splitlines(), start=1):
    if "/Users/" in line:
        print(f"README.md:{line_no}", file=sys.stderr)
        print("FAIL: README contains machine-local /Users paths", file=sys.stderr)
        sys.exit(1)

print(
    "OK: no committable secrets or README-local user paths detected "
    f"(source files scanned: {scanned_files})"
)
PY
