#!/usr/bin/env python3
from __future__ import annotations

import argparse
from pathlib import Path
import re
import subprocess
import sys


DEFAULT_ROOT = Path(__file__).resolve().parents[1]
SOURCE_PATHS = [
    ".github",
    ".agents/skills",
    ".codex",
    ".current-agent",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "docs",
    "pytest.ini",
    "scripts",
    "tests",
]
SOURCE_PREFIXES = (
    ".github/",
    ".agents/skills/",
    ".codex/",
    ".current-agent",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "docs/",
    "pytest.ini",
    "scripts/",
    "tests/",
)
SOURCE_SUFFIXES = (
    ".bash",
    ".cjs",
    ".css",
    ".cts",
    ".html",
    ".js",
    ".json",
    ".lock",
    ".md",
    ".mjs",
    ".mts",
    ".py",
    ".scss",
    ".sh",
    ".sql",
    ".toml",
    ".ts",
    ".tsx",
    ".txt",
    ".vue",
    ".xml",
    ".yaml",
    ".yml",
)
EXCLUDED_PARTS = {
    ".git",
    ".run",
    ".tmp",
    ".turbo",
    "__pycache__",
    "coverage",
    "dist",
    "exports",
    "node_modules",
    "outputs",
}
FORBIDDEN_PATH = re.compile(
    r"(^|/)(auth\.json|\.env($|\.)|.*\.(pem|key|p12|pfx)$)"
)
SECRET_PATTERNS = [
    re.compile(rb"gh[opsu]_[A-Za-z0-9_]{30,}"),
    re.compile(rb"github_pat_[A-Za-z0-9_]{20,}"),
    re.compile(rb"(^|[^A-Za-z0-9_])sk-[A-Za-z0-9_-]{20,}"),
    re.compile(rb"AKIA[0-9A-Z]{16}"),
    re.compile(rb"-----BEGIN (RSA |OPENSSH |EC |DSA )?PRIVATE KEY-----"),
]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Scan committable Lab source for secret material.")
    parser.add_argument("--root", type=Path, default=DEFAULT_ROOT, help="Git checkout to scan.")
    return parser.parse_args()


def is_source_path(relative: str) -> bool:
    if not relative.startswith(SOURCE_PREFIXES):
        return False
    name = Path(relative).name
    return relative.endswith(SOURCE_SUFFIXES) or "." not in name


def main() -> int:
    root = parse_args().root.expanduser().resolve()
    if not (root / ".git").is_dir():
        print(f"FAIL: not a git checkout: {root}", file=sys.stderr)
        return 1

    result = subprocess.run(
        [
            "git",
            "ls-files",
            "--cached",
            "--others",
            "--exclude-standard",
            "--",
            *SOURCE_PATHS,
        ],
        cwd=root,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        if result.stderr:
            sys.stderr.write(result.stderr)
        print("FAIL: git ls-files failed", file=sys.stderr)
        return 1

    paths = [line for line in result.stdout.splitlines() if line]
    secret_like_paths = [path for path in paths if FORBIDDEN_PATH.search(path)]
    if secret_like_paths:
        for path in secret_like_paths:
            print(path, file=sys.stderr)
        print("FAIL: committable secret-like file path detected", file=sys.stderr)
        return 1

    findings: set[tuple[str, int]] = set()
    scanned_files = 0
    for relative in paths:
        if set(Path(relative).parts) & EXCLUDED_PARTS or not is_source_path(relative):
            continue
        file_path = root / relative
        if not file_path.is_file():
            continue
        try:
            data = file_path.read_bytes()
        except OSError as exc:
            print(f"{relative}: {exc}", file=sys.stderr)
            print("FAIL: unable to scan file for secrets", file=sys.stderr)
            return 1
        if b"\0" in data[:4096]:
            continue
        scanned_files += 1
        for pattern in SECRET_PATTERNS:
            match = pattern.search(data)
            if match:
                findings.add((relative, data.count(b"\n", 0, match.start()) + 1))

    if findings:
        for path, line in sorted(findings):
            print(f"{path}:{line}", file=sys.stderr)
        print("FAIL: secret-like token detected; content redacted", file=sys.stderr)
        return 1

    for readme_name in ("README.md", "README.zh-CN.md"):
        readme = root / readme_name
        if not readme.is_file():
            continue
        for line_no, line in enumerate(
            readme.read_text(encoding="utf-8", errors="replace").splitlines(),
            start=1,
        ):
            if "/Users/" in line:
                print(f"{readme_name}:{line_no}", file=sys.stderr)
                print("FAIL: README contains machine-local /Users paths", file=sys.stderr)
                return 1

    print(
        "OK: no committable secrets or README-local user paths detected "
        f"(source files scanned: {scanned_files})"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
