#!/usr/bin/env python3
from __future__ import annotations

import argparse
from dataclasses import asdict, dataclass
import json
from pathlib import Path
import re
import sys


LAB_ROOT = Path(__file__).resolve().parents[1]
SEV_FAIL = "fail"
SEV_INFO = "info"

SINKS: list[tuple[re.Pattern[str], str, str]] = [
    (re.compile(r"\b(?:fly|flyctl)\s+secrets\s+(?:set|unset)\b"), "Fly secret mutation", "external"),
    (re.compile(r"\b(?:fly|flyctl)\s+deploy\b"), "Fly deploy", "external"),
    (re.compile(r"\b(?:fly|flyctl)\s+(?:destroy|machines?\s+(?:update|restart|stop|destroy))\b"), "Fly runtime mutation", "external"),
    (re.compile(r"\bgit\s+push\b"), "git push", "external"),
    (re.compile(r"\bgit\s+(?:merge|rebase)\b"), "git history mutation", "repository"),
    (re.compile(r"\bgit\s+(?:reset\s+--hard|clean\s+-[A-Za-z]*[dfx]|checkout\s+--)"), "destructive git command", "repository"),
    (re.compile(r"\bgit\s+worktree\s+(?:add|move|remove|prune)\b"), "git worktree mutation", "repository"),
    (re.compile(r"\bkubectl\s+(?:apply|delete|patch|replace|scale|set|rollout)\b"), "Kubernetes mutation", "external"),
    (re.compile(r"\bhelm\s+(?:install|upgrade|uninstall|rollback)\b"), "Helm mutation", "external"),
    (re.compile(r"\bterraform\s+(?:apply|destroy|import)\b"), "Terraform mutation", "external"),
    (re.compile(r"\baws\s+s3\s+(?:rm|sync|cp)\b"), "AWS S3 mutation", "external"),
    (re.compile(r"\baws\s+(?:cloudformation\s+deploy|ecs\s+update-service|lambda\s+update-function-code|ssm\s+put-parameter)\b"), "AWS service mutation", "external"),
    (
        re.compile(r"\brm\s+(?:--\s+)?-(?=[A-Za-z]*[rR])(?=[A-Za-z]*[fF])[A-Za-z]+\b"),
        "recursive delete",
        "local-delete",
    ),
]

ANNOTATION = re.compile(
    r"#\s*side-effects:\s*(gated|local-bounded|read-only|none)\b",
    re.IGNORECASE,
)
EXPLICIT_GATE = re.compile(
    r"--apply\b|--confirm\b|--execute\b|\bDRY[_-]?RUN\b|\bAPPLY_CHANGES\b",
    re.IGNORECASE,
)
GATE_GUARD = re.compile(
    r"case\b[^\n]*--(?:apply|confirm|execute)|"
    r"if\b[^\n]*--(?:apply|confirm|execute)|"
    r"add_argument\([^\n]*--(?:apply|confirm|execute)|"
    r"\bDRY[_-]?RUN\s*=\s*(?:1|true)|"
    r"\bAPPLY_CHANGES\s*=\s*(?:0|false)",
    re.IGNORECASE,
)


@dataclass
class Finding:
    code: str
    severity: str
    message: str
    file: str
    line: int
    evidence: str


def is_script(path: Path) -> bool:
    if not path.is_file():
        return False
    if path.suffix in {".sh", ".bash", ".mjs", ".js", ".py", ".zsh"}:
        return True
    if path.suffix == "":
        try:
            return path.open("r", encoding="utf-8", errors="replace").readline().startswith("#!")
        except OSError:
            return False
    return False


def normalized_code(line: str) -> str:
    return re.sub(r"\s+", " ", re.sub(r"""["',\[\]()]""", " ", line)).strip()


def scan_file(path: Path, rel: str) -> list[Finding]:
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    text = "\n".join(lines)
    annotation_match = ANNOTATION.search("\n".join(lines[:40]))
    annotation = annotation_match.group(1).lower() if annotation_match else ""
    has_gate = bool(EXPLICIT_GATE.search(text) and GATE_GUARD.search(text))

    findings: list[Finding] = []
    in_docstring = False
    delimiter = ""
    for line_no, line in enumerate(lines, start=1):
        stripped = line.strip()
        if in_docstring:
            if delimiter in line:
                in_docstring = False
            continue
        for candidate in ('"""', "'''"):
            if stripped.startswith(candidate) and stripped.count(candidate) == 1:
                in_docstring = True
                delimiter = candidate
                break
        if in_docstring or not stripped or stripped.startswith("#"):
            continue
        if "re.compile(" in stripped or stripped.startswith(("SINKS", "(re.compile")):
            continue

        code = normalized_code(line)
        for pattern, label, category in SINKS:
            if not pattern.search(code):
                continue
            if category == "local-delete" and stripped.startswith("trap "):
                continue
            if category == "local-delete" and annotation == "local-bounded":
                findings.append(
                    Finding(
                        "LOCAL_DELETE_ANNOTATED",
                        SEV_INFO,
                        f"{label} is explicitly limited to a local bounded path.",
                        rel,
                        line_no,
                        stripped,
                    )
                )
                continue
            if annotation == "gated" and has_gate:
                findings.append(
                    Finding(
                        "MUTATION_GATED",
                        SEV_INFO,
                        f"{label} has an explicit opt-in gate.",
                        rel,
                        line_no,
                        stripped,
                    )
                )
                continue
            findings.append(
                Finding(
                    "MUTATION_UNGATED",
                    SEV_FAIL,
                    f"{label} is reachable without a verified default-safe apply/confirm gate.",
                    rel,
                    line_no,
                    stripped,
                )
            )
    return findings


def collect_scripts(target: Path) -> list[Path]:
    if target.is_file():
        return [target] if is_script(target) else []
    return sorted(path for path in target.rglob("*") if is_script(path))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Reject scripts with ungated mutation sinks.")
    parser.add_argument("target", nargs="?", default="scripts")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    target = Path(args.target)
    if not target.is_absolute():
        target = LAB_ROOT / target
    if not target.exists():
        print(f"FAIL: target not found: {target}", file=sys.stderr)
        return 2

    scripts = collect_scripts(target)
    findings: list[Finding] = []
    for path in scripts:
        try:
            rel = str(path.relative_to(LAB_ROOT))
        except ValueError:
            rel = str(path)
        findings.extend(scan_file(path, rel))
    failures = [finding for finding in findings if finding.severity == SEV_FAIL]

    if args.json:
        print(
            json.dumps(
                {
                    "target": str(target),
                    "scanned": len(scripts),
                    "fail": len(failures),
                    "findings": [asdict(finding) for finding in findings],
                },
                indent=2,
                ensure_ascii=False,
            )
        )
    else:
        for finding in failures:
            print(
                f"  [fail] {finding.code} {finding.file}:{finding.line}\n"
                f"        {finding.message}\n"
                f"        > {finding.evidence}"
            )
        print(f"target: {target}")
        print(f"scanned scripts: {len(scripts)}")
        print(f"status: {'fail' if failures else 'pass'}  (fail={len(failures)})")
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
